DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bitacora_incidencias
# TLS contra MySQL/Aiven; REQUIRED o 1 activa,false/0 la desactiva.
DB_SSL=1
# CA del proyecto Aiven, relativa a backend/ (solo cuando DB_SSL está activo).
DB_SSL_CA=certs/ca.pem
SESSION_SECRET=cambia_esto_por_algo_largo_y_aleatorio
NODE_ENV=development
